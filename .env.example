# ============================================================================
# AUTOMIQO OS — ENVIRONMENT
# ----------------------------------------------------------------------------
# Copy to `.env` and fill in the blanks:  cp .env.example .env
# Every variable the code actually reads is listed here. Values with a real
# default are marked "(optional)"; everything else must be set for that
# feature to work. Grouped by subsystem.
# ============================================================================

# ── App ─────────────────────────────────────────────────────────────────────
APP_ENV=production                       # development | production
# HA role for this process: all|web|worker|scheduler. "all" (default) runs
# everything in one process. For horizontal scaling, deploy separate replicas:
# ROLE=web (API), ROLE=worker (N replicas), ROLE=scheduler (1+, run_once-guarded).
ROLE=all
# JWT signing secret — MUST be >=32 chars and random in production.
#   generate:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-32+char-secret
FRONTEND_URL=https://your-domain.com     # used for CORS allow-list
# Shared secret protecting the internal /cron/* endpoints.
#   generate:  openssl rand -hex 24
CRON_SECRET=change-me-random-secret

# ── Security & limits ────────────────────────────────────────────────────────
# true = require a valid bearer token + per-tenant ownership on business
# endpoints. Keep false only for a no-login local demo; set TRUE in production.
REQUIRE_AUTH=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30
# Daily AI spend circuit-breaker per business, USD. 0 = disabled.
DAILY_AI_SPEND_CAP_USD=25
LLM_MAX_RETRIES=3
# Structured-logging level for the backend (DEBUG|INFO|WARNING|ERROR).
LOG_LEVEL=INFO

# ── Autonomy maturity (verification gate, governor, durability, self-improve) ─
# Pre-execution verification/eval gate:
VERIFY_LLM_JUDGE=true             # LLM judges each auto-fired action (uses DEPT_MODEL; only runs if OPENAI_API_KEY set)
VERIFY_ESCALATE_THRESHOLD=0.5     # actions scoring below this are held for owner approval
VERIFY_FAIL_CLOSED=false          # on internal verify error: false=fire (fail-open), true=escalate
VERIFY_CONSISTENCY_SAMPLES=3      # high/critical actions: sample the judge N times & require agreement
VERIFY_GROUNDING=true             # verify referenced customer/appointment/lead IDs actually exist (anti-hallucination)
# Graduated autonomy governor (reliability-based auto-approval):
AUTONOMY_MIN_RUNS=5               # min track record before high/critical actions run automatically
AUTONOMY_MIN_SUCCESS=0.8          # min rolling success rate to keep autonomy (non-low-risk)
# Durable execution (requeue tasks after a restart):
RECOVERY_WINDOW_HOURS=24          # how far back to recover queued/running tasks on boot
RECOVERY_MAX=500                  # max tasks to re-enqueue on boot
# Closed-loop self-improvement (SAFE DEFAULT: off — suggestions still go to owner):
AUTO_IMPROVE=false                # true = auto-canary/adopt/rollback prompt+workflow improvements
CANARY_TOLERANCE=0.05             # allowed metric regression before auto-rollback (5%)
# SLA / escalation timers (surface work sitting too long):
SLA_RECOMMENDATION_HOURS=24       # pending recommendation older than this -> escalate to owner
SLA_TASK_MINUTES=30               # task stuck queued/running longer -> alert; 4x -> force-fail
SLA_SWEEP_INTERVAL_MINUTES=15     # how often the SLA sweep runs

# ── AI models ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...               # required (agents + specialists)
ANTHROPIC_API_KEY=                       # (optional) only if a model uses anthropic/*
NVIDIA_API_KEY=                          # (optional) only if a model uses nvidia/*
CEO_MODEL=openai/gpt-4.1                  # <provider>/<model>
DEPT_MODEL=openai/gpt-4o-mini             # department + manager + specialist model

# ── Supabase ─────────────────────────────────────────────────────────────────
# dashboard.supabase.com -> project -> Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...               # service_role key (backend only, secret)
SUPABASE_ANON_KEY=eyJ...                  # anon/public key (frontend if used)
# Direct Postgres connection string (Settings -> Database -> Connection string).
# Used by Mem0 semantic memory. If unset, memory falls back to pgvector-in-app.
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
# Alias also accepted by the Mem0 backend (same value as SUPABASE_DB_URL):
MEM0_DB_URL=

# ── Redis (task/event queue) ─────────────────────────────────────────────────
# Local/docker-compose default. Inside compose use redis://redis:6379 (the bundled
# Redis now runs with AOF persistence + a volume). For production HA, prefer a
# MANAGED Redis (Upstash / ElastiCache / Redis Cloud) — set its TLS URL here
# (rediss://...) and you can drop the bundled redis service. See automiqo-os.md.
REDIS_URL=redis://redis:6379

# ── n8n (workflow engine) ────────────────────────────────────────────────────
# Base URL the dispatcher posts workflow webhooks to.
#   docker-compose: http://n8n:5678/webhook
#   external n8n:   https://your-n8n-instance/webhook
N8N_WEBHOOK_BASE_URL=http://n8n:5678/webhook
N8N_API_KEY=                              # for scripts/deploy_n8n_workflows.py

# ── Telnyx (SMS) — telnyx.com ────────────────────────────────────────────────
TELNYX_API_KEY=KEY...
TELNYX_PHONE_NUMBER=+1...
# Webhook signature verification (Telnyx portal -> your app -> Public Key).
# If unset, inbound-SMS signature verification is SKIPPED (dev only).
TELNYX_PUBLIC_KEY=

# ── Twilio (alternative SMS) — console.twilio.com ────────────────────────────
# (optional — only if you use Twilio instead of / alongside Telnyx)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── VAPI (voice calls) — app.vapi.ai ─────────────────────────────────────────
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=                     # UUID of your VAPI phone number
VAPI_ASSISTANT_ID=                        # default assistant used for calls
VAPI_VOICE_ID=21m00Tcm4TlvDq8ikWAM        # (optional) 11labs voice id, has a default
# Shared secret sent by VAPI as the x-vapi-secret header. If unset, call
# webhook signature verification is SKIPPED (dev only).
VAPI_WEBHOOK_SECRET=

# ── Cal.com (booking) — cal.com/settings/developer/api-keys ──────────────────
CAL_COM_API_KEY=cal_live_...
CAL_COM_BASE_URL=https://api.cal.com/v2
CAL_COM_API_VERSION=2024-08-13
CAL_COM_EVENT_TYPE_30MIN=                  # numeric event-type id
CAL_COM_EVENT_TYPE_15MIN=                  # (optional) numeric event-type id
# Cal.com webhook signing secret (HMAC-SHA256). If unset, appointment webhook
# signature verification is SKIPPED (dev only).
CAL_WEBHOOK_SECRET=
# Inbound-email webhook secret (HMAC-SHA256 of the raw body, hex in the
# x-email-signature-256 header). If unset, /webhooks/email/inbound skips
# verification (dev only). Point your email provider's inbound-parse webhook at
# https://<your-domain>/webhooks/email/inbound
EMAIL_WEBHOOK_SECRET=

# ── Resend (transactional email) — resend.com/api-keys ───────────────────────
RESEND_API_KEY=re_...

# ── Serper.dev (lead scraping) — serper.dev ──────────────────────────────────
SERPER_API_KEY=

# ── Stripe (payments) — dashboard.stripe.com ─────────────────────────────────
# (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Slack (chat with the AI team) — app.slack.com/apps ───────────────────────
# Create an app, then grab: OAuth & Permissions -> Bot User OAuth Token, and
# Basic Information -> Signing Secret. Point Event Subscriptions "Request URL"
# at https://<your-domain>/webhooks/slack/events and subscribe to
# app_mention + message events. If SLACK_SIGNING_SECRET is blank, signature
# verification is skipped (dev only).
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=

# ── Frontend (Next.js) ───────────────────────────────────────────────────────
# BACKEND_URL is what the Next.js proxy (app/api/proxy) forwards to — this is
# SERVER-SIDE, so inside docker-compose it must be the service name, not localhost.
#   docker-compose: http://backend:8000
#   local dev:      http://localhost:8000
BACKEND_URL=http://backend:8000
# Default tenant the UI loads (until multi-tenant login is wired).
NEXT_PUBLIC_BUSINESS_ID=00000000-0000-0000-0000-000000000001

# ── Autonomous scheduler ─────────────────────────────────────────────────────
AUTONOMOUS_MODE=true
# Department daily work hour (24h clock, EST). COO=6 CMO=8 CRO=9 CFO=10 CTO=14 CSD=15 LEARNING=22
DEPT_SCHEDULE_COO=6
DEPT_SCHEDULE_CMO=8
DEPT_SCHEDULE_CRO=9
DEPT_SCHEDULE_CFO=10
DEPT_SCHEDULE_CTO=14
DEPT_SCHEDULE_CSD=15
DEPT_SCHEDULE_LEARNING=22
HEARTBEAT_INTERVAL_MINUTES=60
URGENT_SCAN_INTERVAL_MINUTES=5

# ── Manager autonomy ─────────────────────────────────────────────────────────
# Each of the 32 managers takes its own periodic "shift" (recall -> think ->
# flag dept head -> remember). false = managers run only under dept heads.
# One pulse = one cheap DEPT_MODEL call; raise the interval to cut cost.
MANAGER_AUTONOMY=true
MANAGER_PULSE_INTERVAL_MINUTES=180


# ── UGC Ad Studio (feature #8) ───────────────────────────────────────────────
# OPTIONAL. If unset, ad concepts still generate but video returns "script_only"
# (no render). Point VIDEO_API_URL at your provider (HeyGen/Runway-style REST,
# Bearer auth, JSON body); swap the payload in ugc_ad_studio.generate_video.
VIDEO_API_KEY=
VIDEO_API_URL=https://api.video-provider.example/v1/videos

# ── Inbound WhatsApp agent (feature #10) ─────────────────────────────────────
# Shared secret for verifying inbound WhatsApp webhooks. If unset, signature
# verification is skipped (dev-friendly); if set, sender must HMAC-SHA256 the
# raw body and send the hex digest in the 'x-whatsapp-signature-256' header.
WHATSAPP_WEBHOOK_SECRET=
# WhatsApp sender number for outbound replies (Twilio WhatsApp). Reuses
# TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN above. e.g. whatsapp:+14155238886
WHATSAPP_FROM=
TWILIO_WHATSAPP_FROM=
